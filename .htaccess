# Diwali Lottery - Apache settings
Options -Indexes
DirectoryIndex index.php

# Block access to sensitive files in the web root
<FilesMatch "^(\.env.*|database\.sql|composer\.(json|lock)|.*\.md|.*\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php7.c>
    php_value upload_max_filesize 8M
    php_value post_max_size 10M
</IfModule>
<IfModule mod_php.c>
    php_value upload_max_filesize 8M
    php_value post_max_size 10M
</IfModule>
