# Diwali Lottery - environment settings.
# Production: this file lives at <deploy path>/shared/.env (owner deploy, group lottery, mode 640)
# and is symlinked into each release as .env. NEVER commit a real .env.

LOTTERY_DB_HOST=127.0.0.1
LOTTERY_DB_PORT=3306
LOTTERY_DB_NAME=diwali_lottery
LOTTERY_DB_USER=lottery
LOTTERY_DB_PASS=change-me

# Detailed error messages. Must be false in production.
LOTTERY_APP_DEBUG=false
